
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Table untuk konfigurasi dokumen (existing)
model documents {
  id              Int               @id @default(autoincrement())
  type            String            @db.VarChar(50)
  prodi           String?           @db.VarChar(100)
  template_path   String?           @db.VarChar(255)
  description     String?           @db.Text
  version         String?           @db.VarChar(10) @default("1.0") // Version control untuk template
  is_active       Boolean           @default(true) // Status aktif template
  max_filesize_mb Int?              @default(10) // Maksimal ukuran file output dalam MB
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @updatedAt @db.Timestamp(6)
  
  // Relations
  document_fields document_fields[]
  signed_documents signed_documents[]
  document_templates document_templates[]
  
  @@unique([type, prodi])
}

model document_fields {
  id            Int        @id @default(autoincrement())
  document_id   Int?
  field_name    String     @db.VarChar(255)
  field_type    String     @db.VarChar(50)
  is_required   Boolean?   @default(true)
  default_value String?    @db.Text
  validation_rules String? @db.Text // JSON untuk rules validasi (min/max length, pattern, dll)
  help_text     String?    @db.VarChar(500) // Teks bantuan untuk field
  display_order Int?       @default(0) // Urutan tampilan field
  is_active     Boolean?   @default(true) // Status aktif field
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @updatedAt @db.Timestamp(6)
  
  // Relations
  documents     documents? @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Table untuk template dokumen fisik
model document_templates {
  id              Int       @id @default(autoincrement())
  document_id     Int
  template_name   String    @db.VarChar(255)
  file_path       String    @db.VarChar(500)
  file_type       String    @db.VarChar(10) @default("docx") // docx, pdf, odt
  file_size       Int?      // Size dalam bytes
  checksum        String?   @db.VarChar(64) // Checksum untuk integritas file
  is_default      Boolean   @default(false) // Template default untuk document type
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)
  
  // Relations
  document        documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  
  @@unique([document_id, template_name])
}

// Table untuk kategori dokumen
model document_categories {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  color_hex   String?  @db.VarChar(7) @default("#3B82F6") // Warna untuk UI
  icon        String?  @db.VarChar(50) // Nama icon untuk UI
  sort_order  Int?     @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)
}

// Table untuk menyimpan penandatangan yang terdaftar
model signers {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  nip          String?  @db.VarChar(50)
  email        String?  @db.VarChar(255) // Email untuk notifikasi
  phone        String?  @db.VarChar(20) // Nomor telepon
  role         String   @db.VarChar(100) // dosen_pembimbing, ketua_prodi, dekan
  department   String?  @db.VarChar(100)
  prodi        String?  @db.VarChar(100)
  public_key   String   @db.Text // EdDSA public key
  private_key  String   @db.Text // EdDSA private key (encrypted)
  key_id       String   @db.VarChar(32) // Unique identifier untuk key
  signature_image_path String? @db.VarChar(500) // Path ke gambar tanda tangan
  position_title String? @db.VarChar(255) // Jabatan lengkap untuk tanda tangan
  is_active    Boolean  @default(true)
  last_signed_at DateTime? @db.Timestamp(6) // Kapan terakhir menandatangani
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)
  
  // Relations
  document_signatures document_signatures[]
  
  @@unique([nip])
  @@unique([key_id])
  @@unique([email])
}

// Table untuk menyimpan dokumen yang telah ditandatangani
model signed_documents {
  id               String   @id @default(uuid())
  document_type    String   @db.VarChar(50)
  prodi            String   @db.VarChar(100)
  document_content String   @db.Text // Original document content atau path
  document_hash    String   @db.VarChar(64) // SHA-256 hash
  no_surat         String?  @db.VarChar(100)
  file_path        String?  @db.VarChar(500)
  file_size        Int?     // Ukuran file dalam bytes
  qr_code_data     String   @db.Text // JSON data untuk QR Code
  qr_code_image    String?  @db.VarChar(500) // Path ke QR Code image
  
  // Multi-signature metadata
  total_signatures_required Int     @default(3)
  total_signatures_received Int     @default(0)
  is_complete              Boolean @default(false)
  
  // Document metadata
  created_by       String?  @db.VarChar(255) // User yang membuat dokumen
  approved_by      String?  @db.VarChar(255) // User yang menyetujui
  priority_level   String?  @db.VarChar(20) @default("normal") // urgent, high, normal, low
  expiry_date      DateTime? @db.Timestamp(6) // Tanggal kadaluarsa dokumen
  
  // Status tracking
  status           String   @db.VarChar(50) @default("pending") // pending, in_progress, completed, rejected, expired
  status_notes     String?  @db.Text // Catatan status
  
  // Timestamps
  created_at       DateTime @default(now()) @db.Timestamp(6)
  completed_at     DateTime? @db.Timestamp(6)
  last_updated_at  DateTime @updatedAt @db.Timestamp(6)
  
  // Relations
  document_id      Int?
  documents        documents? @relation(fields: [document_id], references: [id])
  document_signatures document_signatures[]
  verification_logs verification_logs[]
  document_history document_history[]
}

// Table untuk menyimpan setiap signature individual
model document_signatures {
  id              Int      @id @default(autoincrement())
  signed_doc_id   String   // FK ke signed_documents
  signer_id       Int      // FK ke signers
  signature_data  String   @db.Text // EdDSA signature dalam base64
  signature_hash  String   @db.VarChar(64) // Hash dari signature untuk quick lookup
  signer_info     String   @db.Text // JSON dengan info penandatangan
  algorithm       String   @db.VarChar(50) @default("EdDSA")
  timestamp       DateTime @default(now()) @db.Timestamp(6)
  is_valid        Boolean  @default(true)
  
  // Relations
  signed_document signed_documents @relation(fields: [signed_doc_id], references: [id], onDelete: Cascade)
  signer          signers @relation(fields: [signer_id], references: [id])
  
  @@unique([signed_doc_id, signer_id]) // Satu signer hanya bisa menandatangani satu dokumen sekali
}

// Table untuk log verifikasi
model verification_logs {
  id              Int      @id @default(autoincrement())
  signed_doc_id   String   // FK ke signed_documents
  verifier_ip     String?  @db.VarChar(45)
  verifier_agent  String?  @db.Text
  verification_method String @db.VarChar(50) // qr_scan, api_call, manual
  verification_result Boolean
  verification_details String? @db.Text // JSON dengan detail hasil verifikasi
  verified_at     DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  signed_document signed_documents @relation(fields: [signed_doc_id], references: [id], onDelete: Cascade)
}

// Table untuk konfigurasi signature requirements berdasarkan document type
model document_signature_config {
  id                        Int      @id @default(autoincrement())
  document_type             String   @unique @db.VarChar(50) // kkp, kkplus, bimbingan
  required_signature_count  Int      @default(1)
  required_roles            String[] // Array dari required roles
  description               String?  @db.Text
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now()) @db.Timestamp(6)
  updated_at               DateTime @updatedAt @db.Timestamp(6)
}

// Table untuk konfigurasi sistem
model system_config {
  id          Int      @id @default(autoincrement())
  config_key  String   @unique @db.VarChar(100)
  config_value String  @db.Text
  description String?  @db.Text
  updated_at  DateTime @updatedAt @db.Timestamp(6)
}

// Table untuk history perubahan dokumen
model document_history {
  id              Int      @id @default(autoincrement())
  signed_doc_id   String   // FK ke signed_documents
  action          String   @db.VarChar(50) // created, signed, updated, rejected, completed
  description     String   @db.Text // Deskripsi aksi yang dilakukan
  performed_by    String?  @db.VarChar(255) // User yang melakukan aksi
  ip_address      String?  @db.VarChar(45) // IP address user
  user_agent      String?  @db.Text // Browser/app info
  metadata        String?  @db.Text // Additional data dalam JSON format
  created_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  signed_document signed_documents @relation(fields: [signed_doc_id], references: [id], onDelete: Cascade)
}

// Table untuk notifikasi sistem
model notifications {
  id            Int      @id @default(autoincrement())
  recipient     String   @db.VarChar(255) // Email atau user ID
  title         String   @db.VarChar(255)
  message       String   @db.Text
  type          String   @db.VarChar(50) @default("info") // info, warning, error, success
  is_read       Boolean  @default(false)
  read_at       DateTime? @db.Timestamp(6)
  related_doc_id String? // Optional FK ke signed_documents
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

// Table untuk audit log
model audit_logs {
  id          Int      @id @default(autoincrement())
  table_name  String   @db.VarChar(100) // Nama table yang diubah
  record_id   String   @db.VarChar(100) // ID record yang diubah
  operation   String   @db.VarChar(20) // INSERT, UPDATE, DELETE
  old_values  String?  @db.Text // JSON nilai lama
  new_values  String?  @db.Text // JSON nilai baru
  user_info   String?  @db.VarChar(255) // Info user yang melakukan perubahan
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamp(6)
}
