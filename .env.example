# Server Configuration
PORT=8080
NODE_ENV=production

# Domain Configuration - CHANGE THESE FOR YOUR DOMAIN
DOMAIN=yourdomain.com
PROTOCOL=https

# Base URL untuk QR Code dan verifikasi - CHANGE THIS FOR YOUR DOMAIN
BASE_URL=https://yourdomain.com

# Database Configuration
DB_FILE=./db.json

# File Paths
TEMPLATE_DIR=./templates
OUTPUT_DIR=./templates/output
QR_CODE_DIR=./templates/qr-code

# Application Configuration
APP_NAME="Document Generator"
APP_VERSION="3.1.0-secure"
PRODI_NAME="Informatika"
FAKULTAS="Fakultas Teknik"
UNIVERSITAS="Universitas Example"