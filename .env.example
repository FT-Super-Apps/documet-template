# Server
PORT=8080

# Backend public base URL (used in logs, seeds, QR fallbacks)
BASE_URL=http://localhost:8080

# Frontend verification app base URL (used for QR links)
# Example: https://app.my-domain.com or http://localhost:3000
VERIFY_APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/generate_document_db?schema=public

