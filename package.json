{
  "name": "generate-document-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --detectOpenHandles --forceExit",
    "test:integration": "jest tests/integration --detectOpenHandles --forceExit",
    "test:e2e": "jest tests/e2e --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "seed": "node ./prisma/seed.js",
    "seed:eddsa": "node ./prisma/seed-eddsa-system.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "routes/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/tests/**"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "author": "devnolife",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "axios": "^1.12.1",
    "cors": "^2.8.5",
    "docxtemplater": "^3.53.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "jimp": "^1.6.0",
    "moment": "^2.30.1",
    "moment-hijri": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "pizzip": "^3.1.7",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4"
  }
}
